<script>
const Games={},MATE=1e5,now=()=>performance.now(),$=s=>document.querySelector(s);
const slideStyle=(o,l,i,px)=>{if(!o.anim||!l||l.t!==i||l.f==null||l.f===l.t)return'';const[a,b]=px(l.f),[c,d]=px(i);return` class="sl" style="--dx:${a-c}px;--dy:${b-d}px"`};
function stdClick(G,S,ui,i){ui.promo=null;const ms=G.moves(S).filter(m=>m.f===ui.sel&&m.t===i);if(ms.length){ui.sel=null;if(ms.length>1){ui.promo=ms;return}return ms[0]}ui.sel=G.own(S,i)?i:null}
const disc=(o,S,i,px,r,t,s,k='')=>{const[x,y]=px(i);return`<g${slideStyle(o,S.last,i,px)}><circle cx="${x}" cy="${y}" r="${r}" class="pc s${s} ${k}"/><text x="${x}" y="${y+1}" class="pt s${s}" font-size="${r*1.1}">${t}</text></g>`};
const dot=(px,i,c,r=10)=>{const[x,y]=px(i);return`<circle cx="${x}" cy="${y}" r="${c?r*2.4:r}" class="${c?'hint-cap':'hint'}"/>`};
const hit=(px,i,r)=>{const[x,y]=px(i);return`<circle cx="${x}" cy="${y}" r="${r}" fill="transparent" data-i="${i}"/>`};
const mark=(px,S,ui,r)=>{let h='';const L=S.last;for(const i of L?[L.f,L.t]:[])if(i!=null){const[x,y]=px(i);h+=`<circle cx="${x}" cy="${y}" r="${r}" class="hl-last"/>`}if(ui.sel!=null){const[x,y]=px(ui.sel);h+=`<circle cx="${x}" cy="${y}" r="${r}" class="hl-sel"/>`}return h};
const hints=(G,S,ui,px)=>ui.sel==null?'':G.moves(S).filter(m=>m.f===ui.sel).map(m=>dot(px,m.t,S.b[m.t])).join('');
function nm(G,S,d,a,b){if(S.over)return S.over.w==null?0:-MATE-d;if(!d)return G.ev(S);let v=-1e9;for(const m of G.moves(S)){const x=-nm(G,G.play(S,m),d-1,-b,-a);if(x>v)v=x;if(v>a)a=v;if(a>=b)break}return v}
function sbot(G,S,lv){let best=null,bv=-1e9;const d=[1,2,3][lv-1],nz=[40,8,0][lv-1];for(const m of G.moves(S)){const v=-nm(G,G.play(S,m),d-1,-1e9,1e9)+Math.random()*nz;if(v>bv){bv=v;best=m}}return best}

/* ===== Cờ vua ===== */
(() => {
  const P = 1, N = 2, B = 3, R = 4, Q = 5, K = 6;
  const GLY = { 1: '♟︎', 2: '♞', 3: '♝', 4: '♜', 5: '♛', 6: '♚' };
  const ORTH = [[-1, 0], [1, 0], [0, -1], [0, 1]], DIAG = [[-1, -1], [-1, 1], [1, -1], [1, 1]];
  const KNT = [], KGT = [], RAYS = [];
  for (let i = 0; i < 64; i++) {
    const r = i >> 3, c = i & 7; KNT[i] = []; KGT[i] = []; RAYS[i] = [];
    for (const [dr, dc] of [[-2, -1], [-2, 1], [-1, -2], [-1, 2], [1, -2], [1, 2], [2, -1], [2, 1]]) {
      const rr = r + dr, cc = c + dc; if (rr >= 0 && rr < 8 && cc >= 0 && cc < 8) KNT[i].push(rr * 8 + cc);
    }
    for (const [dr, dc] of ORTH.concat(DIAG)) {
      const rr = r + dr, cc = c + dc; if (rr >= 0 && rr < 8 && cc >= 0 && cc < 8) KGT[i].push(rr * 8 + cc);
      const ray = [];
      for (let k = 1; ; k++) { const r2 = r + dr * k, c2 = c + dc * k; if (r2 < 0 || r2 > 7 || c2 < 0 || c2 > 7) break; ray.push(r2 * 8 + c2); }
      RAYS[i].push(ray);
    }
  }

  function attacked(b, sq, by) {
    const r = sq >> 3, c = sq & 7;
    const pr = by > 0 ? r + 1 : r - 1;
    if (pr >= 0 && pr < 8) {
      if (c > 0 && b[pr * 8 + c - 1] === by * P) return true;
      if (c < 7 && b[pr * 8 + c + 1] === by * P) return true;
    }
    for (const t of KNT[sq]) if (b[t] === by * N) return true;
    for (const t of KGT[sq]) if (b[t] === by * K) return true;
    const rays = RAYS[sq];
    for (let d = 0; d < 8; d++) {
      const ray = rays[d];
      for (let k = 0; k < ray.length; k++) {
        const v = b[ray[k]];
        if (v) { if (v * by > 0) { const a = v * by; if (a === Q || (d < 4 ? a === R : a === B)) return true; } break; }
      }
    }
    return false;
  }

  function gen(pos, capOnly) {
    const b = pos.b, s = pos.stm, out = [];
    for (let i = 0; i < 64; i++) {
      const v = b[i]; if (!v || v * s < 0) continue;
      const a = v * s, r = i >> 3, c = i & 7;
      if (a === P) {
        const dir = s > 0 ? -1 : 1, r1 = r + dir, start = s > 0 ? 6 : 1, last = s > 0 ? 0 : 7;
        if (r1 < 0 || r1 > 7) continue;
        const f1 = r1 * 8 + c;
        if (!b[f1]) {
          if (r1 === last) { for (const pr of [Q, R, B, N]) out.push({ f: i, t: f1, pr, fl: 0 }); }
          else if (!capOnly) {
            out.push({ f: i, t: f1, pr: 0, fl: 0 });
            if (r === start && !b[f1 + dir * 8]) out.push({ f: i, t: f1 + dir * 8, pr: 0, fl: 1 });
          }
        }
        for (const dc of [-1, 1]) {
          const cc = c + dc; if (cc < 0 || cc > 7) continue;
          const t = r1 * 8 + cc;
          if (b[t] && b[t] * s < 0) {
            if (r1 === last) { for (const pr of [Q, R, B, N]) out.push({ f: i, t, pr, fl: 0 }); }
            else out.push({ f: i, t, pr: 0, fl: 0 });
          } else if (t === pos.ep) out.push({ f: i, t, pr: 0, fl: 2 });
        }
      } else if (a === N || a === K) {
        for (const t of (a === N ? KNT[i] : KGT[i])) {
          const w = b[t]; if (w * s > 0) continue; if (capOnly && !w) continue;
          out.push({ f: i, t, pr: 0, fl: 0 });
        }
        if (a === K && !capOnly && i === (s > 0 ? 60 : 4)) {
          const opp = -s;
          if ((pos.cr & (s > 0 ? 1 : 4)) && b[i + 3] === s * R && !b[i + 1] && !b[i + 2] &&
            !attacked(b, i, opp) && !attacked(b, i + 1, opp) && !attacked(b, i + 2, opp)) out.push({ f: i, t: i + 2, pr: 0, fl: 3 });
          if ((pos.cr & (s > 0 ? 2 : 8)) && b[i - 4] === s * R && !b[i - 1] && !b[i - 2] && !b[i - 3] &&
            !attacked(b, i, opp) && !attacked(b, i - 1, opp) && !attacked(b, i - 2, opp)) out.push({ f: i, t: i - 2, pr: 0, fl: 4 });
        }
      } else {
        const d0 = a === B ? 4 : 0, d1 = a === R ? 4 : 8;
        for (let d = d0; d < d1; d++) {
          const ray = RAYS[i][d];
          for (let k = 0; k < ray.length; k++) {
            const t = ray[k], w = b[t];
            if (w) { if (w * s < 0) out.push({ f: i, t, pr: 0, fl: 0 }); break; }
            if (!capOnly) out.push({ f: i, t, pr: 0, fl: 0 });
          }
        }
      }
    }
    return out;
  }

  function make(pos, m) {
    const b = pos.b, p = b[m.f], s = pos.stm;
    const u = { cr: pos.cr, ep: pos.ep, cp: b[m.t], p, wk: pos.wk, bk: pos.bk, cpi: -1 };
    b[m.t] = m.pr ? s * m.pr : p; b[m.f] = 0;
    if (m.fl === 2) { u.cpi = m.t + (s > 0 ? 8 : -8); u.cp = b[u.cpi]; b[u.cpi] = 0; }
    else if (m.fl === 3) { b[m.f + 1] = b[m.f + 3]; b[m.f + 3] = 0; }
    else if (m.fl === 4) { b[m.f - 1] = b[m.f - 4]; b[m.f - 4] = 0; }
    if (Math.abs(p) === K) { if (s > 0) { pos.wk = m.t; pos.cr &= ~3; } else { pos.bk = m.t; pos.cr &= ~12; } }
    if (m.f === 63 || m.t === 63) pos.cr &= ~1;
    if (m.f === 56 || m.t === 56) pos.cr &= ~2;
    if (m.f === 7 || m.t === 7) pos.cr &= ~4;
    if (m.f === 0 || m.t === 0) pos.cr &= ~8;
    pos.ep = m.fl === 1 ? (m.f + m.t) >> 1 : -1;
    pos.stm = -s;
    return u;
  }
  function unmake(pos, m, u) {
    pos.stm = -pos.stm; const b = pos.b;
    b[m.f] = u.p;
    if (m.fl === 2) { b[m.t] = 0; b[u.cpi] = u.cp; } else b[m.t] = u.cp;
    if (m.fl === 3) { b[m.f + 3] = b[m.f + 1]; b[m.f + 1] = 0; }
    else if (m.fl === 4) { b[m.f - 4] = b[m.f - 1]; b[m.f - 1] = 0; }
    pos.cr = u.cr; pos.ep = u.ep; pos.wk = u.wk; pos.bk = u.bk;
  }
  const inChk = pos => attacked(pos.b, pos.stm > 0 ? pos.wk : pos.bk, -pos.stm);
  function legal(pos, capOnly) {
    const ms = gen(pos, capOnly), out = [], s = pos.stm;
    for (const m of ms) {
      const u = make(pos, m);
      if (!attacked(pos.b, s > 0 ? pos.wk : pos.bk, -s)) out.push(m);
      unmake(pos, m, u);
    }
    return out;
  }
  function perft(pos, d) {
    if (!d) return 1; let n = 0;
    for (const m of legal(pos)) { const u = make(pos, m); n += perft(pos, d - 1); unmake(pos, m, u); }
    return n;
  }
  const clone = p => ({ b: p.b.slice(), stm: p.stm, cr: p.cr, ep: p.ep, wk: p.wk, bk: p.bk });
  function newPos() {
    const b = new Int8Array(64), back = [R, N, B, Q, K, B, N, R];
    for (let c = 0; c < 8; c++) { b[c] = -back[c]; b[8 + c] = -P; b[48 + c] = P; b[56 + c] = back[c]; }
    return { b, stm: 1, cr: 15, ep: -1, wk: 60, bk: 4 };
